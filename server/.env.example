# Copy to `.env` and fill in the values from https://console.agora.io.
#
# AGORA_APP_ID is the same App ID the Android app uses (.env at the repo root).
# AGORA_APP_CERTIFICATE is only available after you enable the "primary
# certificate" for the Agora project. Never ship the certificate inside the app.

AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE

# Port the service listens on.
PORT=8080

# How long each minted token stays valid, in seconds (Agora caps this at 86400).
TOKEN_TTL_SECONDS=3600
