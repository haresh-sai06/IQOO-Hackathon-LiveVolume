# ---------------------------------------------------------------------------
# LiveVolume backend configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) and replace the placeholder values, or
# supply the same keys as Gradle properties / environment variables.
#
# The Secrets Gradle plugin reads these keys and exposes them as BuildConfig
# fields, so no credentials are ever hard-coded in the source tree.
#
# NOTE: every line must be either a comment or a KEY=VALUE pair. A bare marker
# line would be parsed as a key with an empty value and break BuildConfig.

# Agora RTC App ID from https://console.agora.io (the free tier is sufficient).
# Without a real value the app cannot join a channel and shows a
# "Tap to enter Agora App ID" banner on the call screen.
AGORA_APP_ID=YOUR_AGORA_APP_ID

# Base URL of the Agora token service (see ./server). The app performs:
#   GET <url>?channel=<channel>&uid=<uid>
# and expects a JSON body of the form: { "token": "<rtc-token>" }
#
# Leave this commented out (or blank) to run Agora in "testing mode" with no
# certificate. That is fine for local development but NOT for production.
# AGORA_TOKEN_SERVER_URL=https://your-token-server.example.com/rtc-token

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
