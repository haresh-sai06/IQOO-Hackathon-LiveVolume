/**
 * docx → Google Form
 * ==================
 *
 * Reads a .docx survey out of your Google Drive, works out what each paragraph
 * is (question / option / heading / instruction), and builds a real Google Form
 * in your account.
 *
 * HOW TO RUN
 * ----------
 *  1. script.google.com  →  New project  →  paste this whole file in.
 *  2. Upload your survey .docx to Drive (leave it as a .docx, do NOT convert
 *     it to a Google Doc — this script reads the raw Office XML).
 *  3. Set CONFIG.DOCX_FILE_NAME below to the file's exact name.
 *  4. Run `previewMapping`. Authorise when asked. Read the log: it prints every
 *     paragraph and what the script decided it was, WITHOUT creating anything.
 *  5. Happy with it? Set CONFIG.PREVIEW_ONLY = false and run
 *     `convertDocxToForm`. The Form lands in your Drive; you get an edit URL
 *     and a share link in the log.
 *
 * WHY PREVIEW FIRST
 * -----------------
 * Docx has no concept of "a survey question". Google Forms has ten of them.
 * The gap is bridged with heuristics (see classify() below), and heuristics are
 * exactly as good as your document's formatting is consistent. Always eyeball
 * the preview before you create the form.
 *
 * KNOWN LIMITS
 * ------------
 *  - File-upload questions cannot be created by the Forms API. If your survey
 *    has one, the script reports it and you add it by hand.
 *  - Images inside the docx are ignored (the API can't place them either).
 *  - Text boxes, tables and comments in the docx are skipped; only the body
 *    paragraphs are read.
 */

var CONFIG = {
  // Identify the source. Set the name, or the Drive file id, or both.
  DOCX_FILE_NAME: 'survey.docx',
  DOCX_FILE_ID: '',

  // Leave this title blank to use the docx's first heading / the file name.
  FORM_TITLE: '',

  // SAFETY SWITCH. true = log the mapping and create nothing.
  PREVIEW_ONLY: true,

  // Where the finished form goes. Blank = your Drive root.
  OUTPUT_FOLDER_NAME: '',

  // Shuffle / collect-email settings for the generated form.
  COLLECT_EMAIL: false,
  SHUFFLE_QUESTIONS: false,
};

/* ------------------------------------------------------------------ *
 * Entry points
 * ------------------------------------------------------------------ */

/** Parse and print the mapping. Creates nothing. Safe to run repeatedly. */
function previewMapping() {
  var blocks = readDocxBlocks_();
  var plan = planForm_(blocks);
  printPlan_(plan);
}

/** Parse and actually create the Google Form. */
function convertDocxToForm() {
  var blocks = readDocxBlocks_();
  var plan = planForm_(blocks);
  printPlan_(plan);

  if (CONFIG.PREVIEW_ONLY) {
    Logger.log('\nPREVIEW_ONLY is true, so no form was created.');
    Logger.log('Set CONFIG.PREVIEW_ONLY = false and run convertDocxToForm again.');
    return;
  }

  var form = FormApp.create(plan.title);
  buildForm_(form, plan);

  if (CONFIG.OUTPUT_FOLDER_NAME) {
    moveToFolder_(form, CONFIG.OUTPUT_FOLDER_NAME);
  }

  Logger.log('\n--- created ---');
  Logger.log('Edit:  ' + form.getEditUrl());
  Logger.log('Share: ' + form.getPublishedUrl());
  Logger.log('Items: ' + form.getItems().length);
}

/* ------------------------------------------------------------------ *
 * Reading the docx
 * ------------------------------------------------------------------ */

/**
 * A .docx is a zip. We pull out word/document.xml and turn every <w:p>
 * paragraph into a {style, text, isList, bold} object.
 *
 * The XML is machine-generated by Word, so a regex scan is a defensible trade
 * here: XmlService requires namespace-aware navigation of w:/r:/w14: prefixes,
 * which is far more code for the same result, and Word never emits CDATA or
 * stray entities inside <w:t>.
 */
function readDocxBlocks_() {
  var blob = resolveDocxBlob_();
  Logger.log('Reading: ' + blob.getName() + ' (' + blob.getBytes().length + ' bytes)');

  var entries = Utilities.unzip(blob);
  var docXml = null;
  for (var i = 0; i < entries.length; i++) {
    if (entries[i].getName() === 'word/document.xml') {
      docXml = entries[i].getDataAsString('UTF-8');
      break;
    }
  }
  if (!docXml) {
    throw new Error(
      'No word/document.xml inside ' + blob.getName() + '. ' +
      'Is this really a .docx? (Renamed .zip / .doc files fail here.)');
  }

  var blocks = [];
  var paraRe = /<w:p(?:\s[^>]*)?>([\s\S]*?)<\/w:p>|<w:p(?:\s[^>]*)?\/>/g;
  var match;
  while ((match = paraRe.exec(docXml)) !== null) {
    var inner = match[1] || '';
    var text = extractText_(inner);
    if (!text) continue; // blank spacer paragraph

    blocks.push({
      text: text,
      style: (inner.match(/<w:pStyle\s+w:val="([^"]+)"/) || [, ''])[1],
      isList: isListParagraph_(inner),
      bold: /<w:b\s*\/>|<w:b\s[^>]*\/>/.test(inner),
    });
  }

  Logger.log('Found ' + blocks.length + ' non-empty paragraphs.');
  return blocks;
}

function resolveDocxBlob_() {
  if (CONFIG.DOCX_FILE_ID) {
    return DriveApp.getFileById(CONFIG.DOCX_FILE_ID).getBlob();
  }
  if (CONFIG.DOCX_FILE_NAME) {
    var files = DriveApp.getFilesByName(CONFIG.DOCX_FILE_NAME);
    if (!files.hasNext()) {
      throw new Error(
        'No Drive file named "' + CONFIG.DOCX_FILE_NAME + '". ' +
        'Check the spelling, or set CONFIG.DOCX_FILE_ID instead.');
    }
    var file = files.next();
    var mime = file.getMimeType();
    if (mime === MimeType.GOOGLE_DOCS) {
      throw new Error(
        '"' + CONFIG.DOCX_FILE_NAME + '" is a Google Doc, not a .docx. ' +
        'In Drive: File > Download > Microsoft Word (.docx), re-upload that, ' +
        'and point this script at the .docx. (Google Docs are stripped of the ' +
        'list/numbering data this script needs.)');
    }
    return file.getBlob();
  }
  throw new Error('Set CONFIG.DOCX_FILE_NAME or CONFIG.DOCX_FILE_ID.');
}

/** Concatenate every <w:t> run, turning tabs/breaks into spaces. */
function extractText_(inner) {
  var out = '';
  var runRe = /<w:t(?:\s[^>]*)?>([\s\S]*?)<\/w:t>|<w:tab\s*\/>|<w:br\s*\/>/g;
  var m;
  while ((m = runRe.exec(inner)) !== null) {
    out += (m[1] !== undefined) ? m[1] : ' ';
  }
  return decodeEntities_(out).replace(/\s+/g, ' ').trim();
}

function decodeEntities_(s) {
  return s
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&#x([0-9a-fA-F]+);/g, function (_, h) {
      return String.fromCharCode(parseInt(h, 16));
    })
    .replace(/&#(\d+);/g, function (_, d) {
      return String.fromCharCode(parseInt(d, 10));
    })
    .replace(/&amp;/g, '&'); // last, so "&amp;lt;" doesn't become "<"
}

/* ------------------------------------------------------------------ *
 * Working out what each paragraph means
 * ------------------------------------------------------------------ */

var QUESTION_NUMBER_RE = /^(?:Q(?:uestion)?\s*)?(\d{1,3})\s*[.)\]:\-]\s*(.+)$/i;
var QUESTION_Q_RE = /^Q(?:uestion)?\s*(\d{1,3})\s*[.):\-]?\s*(.+)$/i;
var RADIO_RE = /^(?:\((?:\s|x|X)?\)|\([a-z]\)|[a-z][.)]|[\u25CB\u25EFo]\s)\s*/;
var CHECKBOX_RE = /^(?:\[(?:\s|x|X)?\]|[\u2610\u2611\u2612\u274F]\s?)\s*/;
var BULLET_RE = /^(?:[\u2022\u25AA\u25CF\u25E6\u2043*\u2013\-]\s+)/;
var OTHER_RE = /^(?:other|any other|prefer not to say)\b/i;

/**
 * Turns the paragraph list into a form plan.
 *
 * The one genuinely tricky call is telling "2. How old are you?" (a question)
 * apart from "2. No" (an option in a Yes/No list). Both are numbered 2. We use
 * *sequence*: once question 4 is open, a following "5." starts question 5,
 * while "1." and "2." are options of question 4. A question number that is
 * exactly the previous question's number + 1 is a question; anything else,
 * when we're collecting options, is an option.
 */
function planForm_(blocks) {
  var plan = {
    title: '',
    description: '',
    sections: [],   // {title, help, questions:[...]}
    notes: [],      // things a human should look at
  };
  var currentSection = { title: '', help: '', questions: [] };
  plan.sections.push(currentSection);

  var current = null;        // question being built
  var pendingHelp = '';      // plain text waiting to become a question's help text
  var lastQuestionNumber = 0;
  var docTitle = '';

  function flush() {
    if (current) {
      currentSection.questions.push(current);
      current = null;
    }
  }

  for (var i = 0; i < blocks.length; i++) {
    var b = blocks[i];
    var headingSize = headingLevel_(b.style);

    /* --- headings --- */
    if (headingSize === 1 && !docTitle) { docTitle = b.text; continue; }
    if (headingSize >= 1) {
      flush();
      currentSection = { title: b.text, help: '', questions: [] };
      plan.sections.push(currentSection);
      pendingHelp = '';
      continue;
    }

    /* --- explicit markers --- */
    var boxMatch = b.text.match(CHECKBOX_RE);
    if (boxMatch && current) { addOption_(current, cleanOption_(b.text.slice(boxMatch[0].length)), 'CHECKBOX', plan); continue; }
    var radioMatch = b.text.match(RADIO_RE);
    if (radioMatch && current) { addOption_(current, cleanOption_(b.text.slice(radioMatch[0].length)), 'RADIO', plan); continue; }
    var bulletMatch = b.text.match(BULLET_RE);
    if (bulletMatch && current) { addOption_(current, cleanOption_(b.text.slice(bulletMatch[0].length)), 'RADIO', plan); continue; }

    /* --- numbered paragraphs: question or option? --- */
    var qm = b.text.match(QUESTION_NUMBER_RE);
    if (qm) {
      var num = parseInt(qm[1], 10);
      var body = qm[2].trim();
      var isNextQuestion = !current || num === lastQuestionNumber + 1;

      if (isNextQuestion) {
        flush();
        lastQuestionNumber = num;
        current = newQuestion_(body, pendingHelp, b);
        pendingHelp = '';
        continue;
      }
      // Not sequential, and we're mid-question: it's an option.
      addOption_(current, cleanOption_(body), 'RADIO', plan);
      continue;
    }

    var qOnly = b.text.match(QUESTION_Q_RE);
    if (qOnly && !/^\d+$/.test(qOnly[1])) {
      flush();
      lastQuestionNumber = parseInt(qOnly[1], 10);
      current = newQuestion_(qOnly[2].trim(), pendingHelp, b);
      pendingHelp = '';
      continue;
    }

    /* --- a question mark is a strong signal --- */
    if (b.text.length < 200 && /\?\s*$/.test(b.text) && !OTHER_RE.test(b.text)) {
      flush();
      current = newQuestion_(b.text, pendingHelp, b);
      pendingHelp = '';
      continue;
    }

    /* --- list paragraph that isn't a question: an option --- */
    if (b.isList && current) {
      addOption_(current, cleanOption_(b.text), 'RADIO', plan);
      continue;
    }

    /* --- short line right after an open question: treat as its option --- */
    if (current && b.text.length <= 40 && !/[.!?]$/.test(b.text) && current.options.length < 12) {
      addOption_(current, cleanOption_(b.text), 'RADIO', plan);
      continue;
    }

    /* --- anything else is instruction text --- */
    if (current) {
      current.help = joinHelp_(current.help, b.text);
    } else if (!currentSection.title) {
      currentSection.help = joinHelp_(currentSection.help, b.text);
    } else {
      pendingHelp = joinHelp_(pendingHelp, b.text);
    }
  }

  flush();

  /* Title + description */
  plan.title = CONFIG.FORM_TITLE ||
    docTitle ||
    plan.sections[0].title ||
    stripExtension_(CONFIG.DOCX_FILE_NAME) ||
    'Survey';
  plan.description = plan.sections[0].help || '';
  if (plan.sections.length && plan.sections[0].title === plan.title) {
    plan.sections[0].title = '';
    plan.sections[0].help = '';
  }

  /* Report anything that needs human attention */
  plan.sections.forEach(function (sec) {
    sec.questions.forEach(function (q) {
      if (!q.options.length && ['CHOICE', 'SCALE', 'DATE'].indexOf(q.kind) === -1 &&
          q.kind !== 'SHORT_ANSWER' && q.kind !== 'PARAGRAPH') {
        plan.notes.push('No options parsed for: "' + q.title + '" — defaulted to short answer.');
      }
      if (/file upload|attach (?:a )?file|upload (?:a )?(?:document|file|photo)/i.test(q.title)) {
        plan.notes.push('File-upload question detected ("' + q.title +
          '"). The Forms API cannot create these — add it manually.');
      }
    });
  });

  return plan;
}

function newQuestion_(text, help, block) {
  var required = false;
  var t = text.replace(/\s*\((?:required|mandatory)\)\s*/i, function () { required = true; return ' '; }).trim();
  if (/\*$/.test(t) && t.length > 3) { required = true; t = t.replace(/\s*\*+\s*$/, ''); }
  if (/\brequired\b/i.test(t) && t.length > 20) { required = true; }

  var kind = 'SHORT_ANSWER';
  var scale = null;

  var scaleMatch = t.match(/\b(?:rate|rating|scale)\b/i) && t.match(/\b(\d{1,2})\s*(?:-|to|\u2013|\u2014)\s*(\d{1,2})\b/);
  if (scaleMatch) {
    var lo = parseInt(scaleMatch[1], 10), hi = parseInt(scaleMatch[2], 10);
    if (lo >= 0 && hi <= 10 && hi > lo) { kind = 'SCALE'; scale = { low: lo, high: hi }; }
  }
  // Free-text intent. "how" and "why" are deliberately stricter: on their own
  // they show up in perfectly ordinary short-answer questions ("How old are
  // you?"), so they only tip the question to a paragraph when it is long
  // enough to actually be asking for a written answer.
  if (/\b(?:explain|describe|elaborate|comments?|feedback|tell us|additional|anything else)\b/i.test(t)) {
    kind = 'PARAGRAPH';
  } else if (/\b(?:why|how)\b/i.test(t) && t.length > 60) {
    kind = 'PARAGRAPH';
  }
  if (kind === 'SHORT_ANSWER' && /^(?:date|date of birth|dob)\b/i.test(t)) { kind = 'DATE'; }

  return {
    title: t,
    help: help || '',
    kind: kind,
    scale: scale,
    required: required,
    options: [],
    optionType: null,
    bold: !!block.bold,
  };
}

function addOption_(question, text, type, plan) {
  if (!question || !text) return;
  question.options.push(text);

  // A scale question's option lines are its end labels ("1 - Poor",
  // "5 - Excellent"), not a list of choices — so they must not demote it.
  // Forms only renders two scale labels, so a scale with three or more
  // labelled points is better expressed as a real multiple-choice question.
  if (question.kind === 'SCALE') {
    if (question.options.length > 2) {
      question.kind = question.options.length > 8 ? 'SHORT_ANSWER' : 'CHOICE';
      question.scale = null;
    }
  } else if (question.kind === 'DATE') {
    question.kind = 'SHORT_ANSWER'; // a date question with choices was misread
  }

  if (question.optionType === null) question.optionType = type;
  else if (question.optionType !== type) question.optionType = 'RADIO'; // mixed markers: safe default
}

function cleanOption_(s) {
  return s.replace(/[;\u2022]+$/, '').replace(/^\s*[\u2013\u2014-]\s*/, '').trim();
}

function joinHelp_(a, b) { return a ? a + '\n' + b : b; }
function stripExtension_(n) { return n ? n.replace(/\.[a-z0-9]+$/i, '') : ''; }
/**
 * Is this paragraph a list item?
 *
 * Two different mechanisms are in play, and checking only one of them is a
 * silent data-loss bug:
 *
 *  - Clicking the bullet button in Word writes an inline <w:numPr>. 
 *  - Applying a list STYLE writes nothing inline at all — the numbering lives
 *    in styles.xml. python-docx's `style="List Bullet"`, and most templates,
 *    produce this second form.
 *
 * Verified against a real .docx: every bulleted paragraph had
 * inlineNumPr=false and style=ListBullet.
 */
function isListParagraph_(inner) {
  if (/<w:numPr[\s>]/.test(inner)) return true;
  var style = (inner.match(/<w:pStyle\s+w:val="([^"]+)"/) || [, ''])[1];
  return /^List/i.test(style);
}

function headingLevel_(style) {
  if (!style) return 0;
  var m = style.match(/^Heading(\d)$/i);
  if (m) return parseInt(m[1], 10);
  if (/^Title$/i.test(style)) return 1;
  if (/^Subtitle$/i.test(style)) return 2;
  return 0;
}

/* ------------------------------------------------------------------ *
 * Building the form
 * ------------------------------------------------------------------ */

function buildForm_(form, plan) {
  if (plan.description) form.setDescription(plan.description);
  if (CONFIG.COLLECT_EMAIL) form.setCollectEmail(true);
  if (CONFIG.SHUFFLE_QUESTIONS) form.setShuffleQuestions(true);

  plan.sections.forEach(function (sec, si) {
    if (si > 0 || sec.title) {
      var header = form.addSectionHeaderItem().setTitle(sec.title || ('Section ' + (si + 1)));
      if (sec.help) header.setHelpText(sec.help);
    }
    sec.questions.forEach(function (q) {
      addQuestion_(form, q);
    });
  });
}

function addQuestion_(form, q) {
  var item = null;

  // A scale is checked first and unconditionally: when it has option lines they
  // are its endpoint labels, not choices, so it must not fall down the branch
  // that turns options into a multiple-choice question.
  if (q.kind === 'SCALE' && q.scale) {
    item = form.addScaleItem().setBounds(q.scale.low, q.scale.high);
    if (q.options.length >= 2) {
      item.setLabels(q.options[0], q.options[q.options.length - 1]);
    }
  } else if (q.options.length) {
    if (q.optionType === 'CHECKBOX') {
      item = form.addCheckboxItem().setChoiceValues(q.options);
    } else if (q.options.length > 8) {
      item = form.addListItem().setChoiceValues(q.options); // long lists read better as a dropdown
    } else {
      item = form.addMultipleChoiceItem().setChoiceValues(q.options);
    }
  } else {
    switch (q.kind) {
      case 'DATE':
        item = form.addDateItem();
        break;
      case 'PARAGRAPH':
        item = form.addParagraphTextItem();
        break;
      default:
        item = form.addTextItem();
    }
  }

  item.setTitle(q.title || '(untitled question)');
  if (q.help) item.setHelpText(q.help);
  if (q.required && typeof item.setRequired === 'function') item.setRequired(true);
}

function moveToFolder_(form, folderName) {
  var folders = DriveApp.getFoldersByName(folderName);
  var folder = folders.hasNext() ? folders.next() : DriveApp.createFolder(folderName);
  DriveApp.getFileById(form.getId()).moveTo(folder);
}

/* ------------------------------------------------------------------ *
 * Reporting
 * ------------------------------------------------------------------ */

function printPlan_(plan) {
  var lines = [];
  lines.push('==============================================');
  lines.push('FORM TITLE: ' + plan.title);
  if (plan.description) lines.push('DESCRIPTION: ' + plan.description);
  lines.push('==============================================');

  plan.sections.forEach(function (sec, si) {
    if (sec.title) lines.push('\n--- SECTION: ' + sec.title + (sec.help ? '  (' + sec.help + ')' : '') + ' ---');
    sec.questions.forEach(function (q, qi) {
      var label;
      if (q.kind === 'SCALE' && q.scale) {
        label = 'SCALE ' + q.scale.low + '-' + q.scale.high;
      } else if (q.options.length) {
        label = q.optionType === 'CHECKBOX' ? 'CHECKBOXES'
          : q.options.length > 8 ? 'DROPDOWN' : 'MULTIPLE CHOICE';
      } else {
        label = q.kind;
      }
      lines.push('  [' + label + (q.required ? ', required' : '') + '] ' + q.title);
      if (q.help) lines.push('        help: ' + q.help.replace(/\n/g, ' / '));
      q.options.forEach(function (o, oi) {
        lines.push('        ' + (q.optionType === 'CHECKBOX' ? '[]' : '(' + (oi + 1) + ')') + ' ' + o);
      });
    });
  });

  if (plan.notes.length) {
    lines.push('\n--- NEEDS A HUMAN ---');
    plan.notes.forEach(function (n) { lines.push('  ! ' + n); });
  }

  var total = plan.sections.reduce(function (n, s) { return n + s.questions.length; }, 0);
  lines.push('\nTotal questions parsed: ' + total);
  Logger.log(lines.join('\n'));
}
